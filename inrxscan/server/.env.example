# Your gateway's base URL (services/gateway) — the only backend address
# this BFF needs to know about. Point this at your production gateway when
# you move to mainnet; nothing else in server/ needs to change.
GATEWAY_URL=http://localhost:3001

# Port this BFF listens on. The frontend's VITE_API_BASE_URL should point
# here (e.g. http://localhost:4000) rather than at the gateway directly.
PORT=4000
