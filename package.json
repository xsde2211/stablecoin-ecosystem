{
  "name": "stablecoin-ecosystem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:packages": "pnpm --filter './packages/*' build",
    "dev:gateway": "pnpm --filter gateway dev",
    "dev:web": "pnpm --filter web dev",
    "docker:dev": "docker compose up -d postgres redis kafka zookeeper",
    "docker:stop": "docker compose down",
    "db:migrate": "pnpm --filter @ecosystem/config prisma migrate dev",
    "db:generate": "pnpm --filter @ecosystem/config prisma generate",
    "db:studio": "pnpm --filter @ecosystem/config prisma studio"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  }
}