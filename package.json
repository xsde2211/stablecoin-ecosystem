{
  "name": "stablecoin-ecosystem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:packages": "pnpm --filter './packages/*' build",
    "dev":          "node tools/scripts/dev.cjs",
    "dev:infra":    "docker compose up -d postgres redis kafka zookeeper",
    "dev:stop":     "docker compose down",
    "dev:all":   "docker compose up -d postgres redis kafka zookeeper && node tools/scripts/dev.cjs",
    "db:migrate":"pnpm --filter @ecosystem/config prisma:migrate",
    "db:generate":"pnpm --filter @ecosystem/config prisma:generate",
    "db:studio": "pnpm --filter @ecosystem/config prisma:studio"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  }
}