{
  "expo": {
    "name": "e-Rupee Ecosystem",
    "slug": "stablecoin-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090F",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090F"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090F"
      },
      "package": "com.stablecoin.wallet",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stablecoin.wallet"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow e-Rupee to scan QR codes for payments"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e9daa870-0a76-48a4-aa97-f05bbc52f8df"
      }
    }
  }
}
