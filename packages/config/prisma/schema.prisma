// packages/config/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  role         UserRole  @default(USER)
  kycStatus    KycStatus @default(PENDING)
  riskScore    Float     @default(0)
  twoFaEnabled Boolean   @default(false)
  twoFaSecret  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wallets         Wallet[]
  kycApplications KycApplication[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  fraudFlags      FraudFlag[]
  merchant        Merchant?
  bridgeTransfers BridgeTransfer[]

  @@index([email])
  @@index([phone])
  @@index([kycStatus])
}

enum UserRole {
  USER
  MERCHANT
  COMPLIANCE
  ADMIN
  SUPER_ADMIN
}

enum KycStatus {
  PENDING
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  REJECTED
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String
  chain         String // ethereum | tron | bsc | polygon | solana
  address       String
  encPrivateKey String // AES-256 encrypted, KMS-managed DEK
  createdAt    DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id])
  transactions Transaction[]
  bridgeSends  BridgeTransfer[] @relation("sender")

  @@unique([userId, chain])
  @@index([address])
  @@index([chain])
}

model Transaction {
  id          String    @id @default(uuid())
  walletId    String
  txHash      String?   
  chain       String
  type        TxType
  amount      Decimal   @db.Decimal(36, 18)
  tokenSymbol String
  fromAddress String
  toAddress   String
  status      TxStatus  @default(PENDING)
  gasUsed     Decimal?
  blockNumber BigInt?
  metadata    Json?
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  wallet   Wallet    @relation(fields: [walletId], references: [id])
  amlFlags AmlFlag[]
  // Partition by month in production via pg_partman

  @@unique([walletId, txHash])
  @@index([walletId])
  @@index([txHash])
  @@index([chain, status])
  @@index([createdAt])
}

enum TxType {
  SEND
  RECEIVE
  MINT
  BURN
  BRIDGE_LOCK
  BRIDGE_MINT
  SWAP
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERTED
}

model BridgeTransfer {
  id            String       @id @default(uuid())
  userId        String
  walletId      String?
  srcChain      String
  dstChain      String
  srcAddress    String
  dstAddress    String
  srcTxHash     String?
  dstTxHash     String?
  amount        String // string to preserve precision
  token         String
  nonce         String
  deadline      DateTime
  status        BridgeStatus @default(PENDING)
  type          BridgeType   @default(LOCK_MINT)
  confirmations Int          @default(0)
  createdAt     DateTime     @default(now())

  user                User                 @relation(fields: [userId], references: [id])
  wallet              Wallet?              @relation("sender", fields: [walletId], references: [id])
  validatorSignatures ValidatorSignature[]

  @@index([srcChain, dstChain])
  @@index([status])
  @@index([userId])
}

enum BridgeStatus {
  PENDING
  LOCKED
  SIGNATURES_COLLECTED
  MINTED
  COMPLETED
  FAILED
  EXPIRED
}

enum BridgeType {
  LOCK_MINT
  BURN_UNLOCK
}

model ValidatorSignature {
  id            String   @id @default(uuid())
  transferId    String
  validatorAddr String
  signature     String
  signedAt      DateTime @default(now())

  transfer BridgeTransfer @relation(fields: [transferId], references: [id])

  @@unique([transferId, validatorAddr])
}

model KycApplication {
  id             String    @id @default(uuid())
  userId         String
  provider       String // manual | hyperverge | digilocker | aadhaar_xml
  status         KycStatus  @default(NOT_SUBMITTED)
  documentType   String?
  documentRef    String? // provider reference ID
  fullName       String?
  dateOfBirth    DateTime?
  address        String?
  verifiedAt     DateTime?
  reviewedAt     DateTime?
  reviewedBy     String?
  rejectedReason String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model Treasury {
  id              String   @id @default(uuid())
  token           String   @unique // INRX | EGOLD | ESLVR
  totalSupply     Decimal  @db.Decimal(36, 18)
  reserveAmount   Decimal  @db.Decimal(36, 18)
  collateralRatio Decimal  @db.Decimal(8, 4)
  updatedAt       DateTime @updatedAt

  reserveEntries ReserveEntry[]
}

model ReserveEntry {
  id         String    @id @default(uuid())
  treasuryId String
  assetType  String // INR_BANK_DEPOSIT | GOLD_VAULT | SILVER_VAULT | GOVT_SECURITIES | USDT_COLLATERAL
  amount     Decimal   @db.Decimal(36, 18)
  custodian  String
  proofUrl   String?
  active     Boolean   @default(true)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  treasury Treasury @relation(fields: [treasuryId], references: [id])

  @@index([treasuryId])
}

model Merchant {
  id                 String   @id @default(uuid())
  userId             String   @unique
  businessName       String
  businessEmail      String?
  gstin              String?
  name               String?  // legacy/back-compat alias for businessName
  apiKey             String   @unique @default(uuid())
  apiSecretHash      String?
  webhookUrl         String?
  settlementAddress  String
  settlementChain    String   @default("tron")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id])
  paymentRequests PaymentRequest[]
}

model PaymentRequest {
  id          String        @id @default(uuid())
  merchantId  String
  amount      Decimal       @db.Decimal(36, 18)
  token       String
  reference   String?
  description String?
  webhookUrl  String?
  status      PaymentStatus @default(PENDING)
  expiresAt   DateTime
  paidAt      DateTime?
  txHash      String?
  paidOnChain String?
  createdAt   DateTime      @default(now())

  merchant  Merchant   @relation(fields: [merchantId], references: [id])
  qrPayment QrPayment?

  @@index([merchantId, status])
  @@index([expiresAt])
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

model QrPayment {
  id        String    @id @default(uuid())
  paymentId String    @unique
  qrData    String
  deepLink  String
  paidAt    DateTime?
  txHash    String?

  payment PaymentRequest @relation(fields: [paymentId], references: [id])
}

model AmlFlag {
  id            String    @id @default(uuid())
  transactionId String
  riskLevel     AmlRisk
  reason        String
  status        AmlStatus @default(PENDING_REVIEW)
  resolvedBy    String?
  resolvedAt    DateTime?
  flaggedAt     DateTime  @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([status])
  @@index([riskLevel])
}

enum AmlRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AmlStatus {
  PENDING_REVIEW
  CLEARED
  ESCALATED
  REPORTED
}

model FraudFlag {
  id              String   @id @default(uuid())
  userId          String
  actionType      String   // SEND | RECEIVE | BRIDGE | PAYMENT
  amount          Decimal  @db.Decimal(36, 18)
  token           String
  toAddress       String?
  chain           String?
  riskScore       Int
  flags           String   // comma-separated flag codes
  status          String   @default("PENDING") // PENDING | CONFIRMED_FRAUD | FALSE_POSITIVE | RESOLVED
  resolutionNotes String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model BlacklistedAddress {
  id        String   @id @default(uuid())
  address   String
  chain     String
  reason    String
  addedBy   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([address, chain])
  @@index([active])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    // KYC_APPROVED | KYC_REJECTED | SYSTEM | ...
  title     String
  body      String
  data      String?   // JSON-encoded extra payload
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  payload    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  // Partition by month in production

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
